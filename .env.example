# ATLAS configuration (copy to .env and adjust). Safe placeholders only - never commit real credentials.
# Values may also be provided as real environment variables (prefix ATLAS_).

ATLAS_APP_NAME=ATLAS
# development | test | production
ATLAS_ENVIRONMENT=development
ATLAS_API_PREFIX=/api/v1
# Leave unset to use SQLite under ATLAS_DATA_DIR (backend/var by default).
# ATLAS_DATABASE_URL=sqlite:///./backend/var/atlas.db
# PostgreSQL 16 (migrations and test suite verified; no deployment has run on it yet):
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:change-me@db.example.internal:5432/atlas
# ATLAS_DATA_DIR=backend/var
# Comma-separated list. Wildcards are rejected in production.
ATLAS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ATLAS_LOG_LEVEL=INFO
ATLAS_MAX_REQUEST_BYTES=1048576
# Demo seeding is allowed by default in development/test and disabled in production unless set true.
# ATLAS_DEMO_DATA_ENABLED=true
# Ingestion. Write endpoints default to on in development/test and OFF in production.
# This is a safety switch, not authorization (ATLAS has no authentication yet).
# ATLAS_WRITE_API_ENABLED=true
ATLAS_MAX_UPLOAD_BYTES=5242880
ATLAS_MAX_INGEST_ROWS=5000
# Registry. Static bearer tokens: "token:actor:role,..." roles viewer|editor|reviewer|admin.
# Tokens are 16-128 URL-safe characters. Unset in dev/test = unauthenticated dev-local admin; unset in production = 503.
# ATLAS_API_TOKENS=
# Optional paths to override resolution / quality scoring configuration.
# ATLAS_RESOLUTION_CONFIG_PATH=
# ATLAS_QUALITY_CONFIG_PATH=

# --- Operational settings (all optional; safe defaults) ---
# Process topology: set false on the API when `python -m app.worker` runs separately (compose does this).
# ATLAS_EMBEDDED_WORKER=true
# ATLAS_ALERTING_TICK_SECONDS=30
# ATLAS_API_RATE_LIMIT_PER_MINUTE=1200
# ATLAS_CACHE_ENABLED=true
# ATLAS_SQLITE_WAL=false

# --- Staging / production (copy to .env.staging / .env.production; NEVER commit those) ---
# ATLAS_ENVIRONMENT=production            # or staging. Both reject wildcard/http CORS, DEBUG logs and weak keys at startup.
# ATLAS_CORS_ALLOWED_ORIGINS=https://atlas.example.com
# ATLAS_INTEGRATIONS_MASTER_KEY=<>=32 random characters from a secret store; required for webhooks>
# The first administrator is created once, interactively: python -m app.auth.cli create-user <name> --platform-admin
# Docker build secret hygiene: VITE_API_BASE_URL (frontend) is public by design; put no secret in any VITE_ variable.
